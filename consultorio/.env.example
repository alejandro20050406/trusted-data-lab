# Copia este archivo a .env.local y llena los valores. .env.local no se sube a git.

# Cadena de conexión de tu rama de Neon (dev-angel o dev-adrian).
# Neon > Branches > tu rama > Connect. Formato: postgresql://usuario:clave@host/neondb?sslmode=require
DATABASE_URL=

# Secreto de Better Auth, de al menos 32 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# URL base de la app. En desarrollo: http://localhost:3000
BETTER_AUTH_URL=

# Secreto que Vercel Cron manda en el encabezado Authorization: Bearer <CRON_SECRET>.
# Genéralo igual que BETTER_AUTH_SECRET.
CRON_SECRET=

# Usuario de prueba de la dentista que crea `npm run db:seed`. Solo para desarrollo:
# usa un correo y una contraseña de prueba, nunca datos reales.
SEED_DENTISTA_EMAIL=
SEED_DENTISTA_PASSWORD=
SEED_DENTISTA_NOMBRE=
