# Copia este archivo a .env.local y llena los valores. .env.local no se sube a git.

# Cadena de conexión de tu rama de Neon (dev-angel o dev-adrian).
# Neon > Branches > tu rama > Connect. Formato: postgresql://usuario:clave@host/neondb?sslmode=require
DATABASE_URL=

# Secreto de Better Auth, de al menos 32 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# URL base de la app. En desarrollo: http://localhost:3000
BETTER_AUTH_URL=

# Secreto que Vercel Cron manda en el encabezado Authorization: Bearer <CRON_SECRET>.
# Genéralo igual que BETTER_AUTH_SECRET.
CRON_SECRET=

# Usuario de prueba de la dentista que crea `npm run db:seed`. Solo para desarrollo:
# usa un correo y una contraseña de prueba, nunca datos reales.
SEED_DENTISTA_EMAIL=
SEED_DENTISTA_PASSWORD=
SEED_DENTISTA_NOMBRE=

# --- Módulo clínico (Adrián) ---

# Bucket PRIVADO de Cloudflare R2 para escaneos y fotos de pacientes (D-05, D-06).
# R2 > Manage API tokens: token con permiso "Object Read & Write" solo para ese bucket.
# Sin estas variables, en desarrollo los archivos se guardan en una carpeta local temporal.
# CORS del bucket: permitir PUT y GET desde el dominio de la app con el encabezado content-type.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional en desarrollo: carpeta del almacén local (por omisión, la carpeta temporal del sistema).
ALMACEN_LOCAL_DIR=

# Notificaciones push (D-12). Genera el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable de la app para los servicios de push, p. ej. mailto:correo-del-consultorio
VAPID_SUBJECT=

# Veces reagendadas a partir de las que se muestra la insignia "Reagenda seguido" (provisional: 3).
UMBRAL_REAGENDA=
